{#- ABOUTME: Jinja2 template that renders CronosPro tables as PostgreSQL CREATE TABLE statements and one INSERT per record. -#}
{#- ABOUTME: Gives every table and column a unique quoted name and writes values as SQL literals, with NULL for empty non-text values. -#}
{% set sql_table_names = {} %}
{%- for table in db.enumerate_tables(files=False) %}
{%- set tablename = unique_sql_table_name(table, sql_table_names) %}
{%- if tablename is not none %}
{%- set columns = unique_sql_column_names(table) %}

CREATE TABLE "{{ tablename }}" (
    {%- for field in table.fields %}
        "{{ columns[loop.index0] }}" {{ field.sqltype() -}}
        {{- ", " if not loop.last else "" -}}
    {%- endfor %}
);

{% for record in db.enumerate_records( table ) -%}
INSERT INTO "{{ tablename }}" VALUES (
    {%- for field in record.fields -%}
        {{ sql_value(table.fields[loop.index0], field) }} {{- ", " if not loop.last else "" -}}
    {%- endfor -%}
);
{% endfor %}
{%- endif %}
{% endfor %}
